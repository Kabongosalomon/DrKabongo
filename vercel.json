{
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "dev.drkabongo.com" }],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "skabongo.github.io" }],
      "destination": "https://drkabongo.com/$1",
      "permanent": true
    }
  ]
}
