# Copy to .env.local for local development; set the same names in Vercel
# (Project → Settings → Environment Variables) for production.
# Every one is optional: without them the blog simply has no comment section
# and the subscribe box offers RSS only.

# Blog comments — Firebase project web config (Project settings → Your apps).
# Not secret: these only identify the project; firestore.rules does the checking.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Your own Firebase Auth uid, so your replies get an "Author" badge.
NEXT_PUBLIC_BLOG_AUTHOR_UID=

# Local only: talk to `firebase emulators:start` instead of the real project.
# NEXT_PUBLIC_FIREBASE_EMULATORS=1

# Newsletter — Kit (free plan). Secret: server-side only.
# API key: Settings → Developer → "Add a new key" (V4).
# Form id: the number in the form's URL (app.kit.com/forms/<id>/edit).
# Put KIT_API_KEY in GitHub too (repo → Settings → Secrets → Actions) for
# .github/workflows/notify-subscribers.yml.
KIT_API_KEY=
KIT_FORM_ID=
